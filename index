<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Colegio Multiplayer</title>
<style>
 *{box-sizing:border-box}
html,body{margin:0;height:100%;overflow:hidden;font-family:'Segoe UI',system-ui,sans-serif;background:#0b1220;color:#fff}
#canvas-container{position:fixed;inset:0;z-index:1}
canvas{touch-action:none;display:block}
#login-overlay{
  position:fixed;inset:0;z-index:100;
  display:flex;justify-content:center;align-items:center;
  background:radial-gradient(circle at 50% 40%,rgba(15,23,42,.35),rgba(15,23,42,.75));
  backdrop-filter:blur(6px);
  transition:opacity .6s ease;
}
#login-overlay.hidden{opacity:0;pointer-events:none}
.login-box{
  width:760px;max-width:calc(100vw - 32px);max-height:calc(100vh - 40px);
  overflow-y:auto;
  padding:28px 30px;
  border-radius:22px;
  background:linear-gradient(160deg,rgba(30,41,59,.85),rgba(15,23,42,.92));
  border:1px solid rgba(148,163,184,.25);
  box-shadow:
    0 30px 80px rgba(0,0,0,.6),
    0 0 0 1px rgba(255,255,255,.04) inset,
    0 -1px 0 rgba(255,255,255,.06) inset;
  backdrop-filter:blur(24px);
  animation:slideUp .5s ease both;
}
@keyframes slideUp{
  from{opacity:0;transform:translateY(20px) scale(.98)}
  to{opacity:1;transform:translateY(0) scale(1)}
}
.login-logo{text-align:center;margin-bottom:18px}
.login-logo .icon{font-size:42px;line-height:1;display:block;margin-bottom:8px;filter:drop-shadow(0 6px 18px rgba(129,140,248,.5))}
.login-logo h1{
  margin:0;font-size:24px;font-weight:800;letter-spacing:-.5px;
  background:linear-gradient(135deg,#e0e7ff,#818cf8 60%,#6366f1);
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
}
.login-logo p{margin:6px 0 0;font-size:12px;color:#94a3b8;letter-spacing:2px;text-transform:uppercase;font-weight:600}
.login-grid{display:grid;grid-template-columns:1fr 220px;gap:22px;align-items:start}
@media(max-width:700px){.login-grid{grid-template-columns:1fr}}
.field{position:relative;margin:12px 0}
.field label,.role-label,.custom-label{
  display:block;font-size:11px;letter-spacing:1.4px;text-transform:uppercase;
  color:#94a3b8;font-weight:700;margin-bottom:6px;
}
.field input{
  width:100%;padding:13px 14px;border-radius:12px;
  background:rgba(15,23,42,.7);border:1px solid rgba(148,163,184,.2);
  color:#fff;font-size:14px;font-family:inherit;
  transition:border-color .15s, box-shadow .15s, background .15s;
}
.field input::placeholder{color:#64748b}
.field input:focus{
  outline:none;border-color:#818cf8;background:rgba(15,23,42,.9);
  box-shadow:0 0 0 4px rgba(129,140,248,.15);
}
.role-label{margin:14px 0 10px}
.roles{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.role-card,.opt{
  padding:12px 8px;border-radius:12px;
  background:rgba(15,23,42,.6);border:1.5px solid rgba(148,163,184,.18);
  cursor:pointer;text-align:center;transition:all .18s ease;user-select:none;
}
.role-card:hover,.opt:hover{transform:translateY(-2px);border-color:rgba(129,140,248,.5);background:rgba(30,41,59,.8)}
.role-card.selected,.opt.selected{
  border-color:#818cf8;
  background:linear-gradient(160deg,rgba(99,102,241,.25),rgba(79,70,229,.15));
  box-shadow:0 0 0 3px rgba(129,140,248,.15);
}
.role-card .emoji{font-size:26px;display:block;margin-bottom:4px}
.role-card .name{font-size:12px;font-weight:700;color:#e2e8f0;margin-bottom:2px}
.role-card .desc{font-size:9px;color:#94a3b8;line-height:1.3}
.custom-label{margin:14px 0 8px}
.opts{display:flex;flex-wrap:wrap;gap:6px}
.opt{padding:8px 10px;font-size:11px;font-weight:700;color:#e2e8f0}
.swatches{display:flex;gap:8px;flex-wrap:wrap}
.swatch{
  width:28px;height:28px;border-radius:50%;cursor:pointer;
  border:2px solid rgba(255,255,255,.2);transition:transform .15s, box-shadow .15s;
}
.swatch:hover{transform:scale(1.1)}
.swatch.selected{box-shadow:0 0 0 3px #818cf8;border-color:#fff}
.preview-wrap{
  background:rgba(15,23,42,.55);
  border:1px solid rgba(148,163,184,.18);
  border-radius:16px;padding:10px;text-align:center;
}
.preview-wrap canvas{width:100%;height:240px;border-radius:12px;background:radial-gradient(circle at 50% 70%,#334155,#0f172a)}
.preview-wrap p{margin:8px 0 0;font-size:11px;color:#94a3b8}
#btn-join{
  width:100%;padding:15px;margin-top:18px;border:none;border-radius:12px;
  background:linear-gradient(135deg,#6366f1,#4f46e5);color:#fff;
  font-size:14px;font-weight:800;letter-spacing:1.2px;text-transform:uppercase;
  cursor:pointer;font-family:inherit;
  box-shadow:0 8px 24px rgba(99,102,241,.4), 0 1px 0 rgba(255,255,255,.15) inset;
}
#btn-join:hover{filter:brightness(1.1)}
#btn-join:active{transform:translateY(1px)}
#ui-bar{
  position:fixed;top:0;left:0;width:100%;
  background:rgba(15,23,42,.85);backdrop-filter:blur(10px);
  display:flex;justify-content:space-around;padding:10px 12px;z-index:10;
  border-bottom:1px solid #334155;font-size:14px;flex-wrap:wrap;gap:6px;
}
.stat-item{background:rgba(255,255,255,.05);padding:6px 12px;border-radius:8px;font-weight:600;border:1px solid rgba(255,255,255,.06)}
.stat-item span{color:#a5b4fc}
#hint{
  position:fixed;bottom:14px;left:50%;transform:translateX(-50%);
  background:rgba(15,23,42,.8);padding:8px 16px;border-radius:30px;
  font-size:12px;color:#cbd5e1;z-index:10;border:1px solid #334155;pointer-events:none;white-space:nowrap;
}
@media(max-width:700px){#hint{display:none}}
</style>
<script type="importmap">
{
  "imports":{
    "three":"https://unpkg.com/three@0.160.0/build/three.module.js",
